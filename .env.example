# Copy this file to ".env.local" and fill in your key.
# The key is read ONLY on the server (in app/api/ask/route.ts). It is never
# shipped to the browser. If you leave it blank, the "Ask my AI" demo still
# works in a built-in fallback mode with canned answers.

ANTHROPIC_API_KEY=

# Optional: override the model used by the demo. Defaults to a fast, cheap model.
AI_MODEL=claude-3-5-haiku-latest

# Optional: distributed rate limiting for /api/ask via Upstash Redis (free tier
# works fine). If left blank, an in-memory per-instance limiter is used
# instead, which still works but resets on redeploy/cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
